from pathlib import Path
import librosa

# .mp3 on ladatut ja .m4a on macbookilla äänitetyt
suffixes = [".mp3", ".m4a"]

audio_dir = Path("aanitteet")
dataset = []

for file in sorted(audio_dir.iterdir()):
    if file.suffix.lower() not in suffixes:    # tarkistaa että pääte kuuluu päätejoukkoon jatkaakseen
        continue

    audio, sr = librosa.load(file, sr=16000)   # Lukee äänen lukujonoksi ja muuntaa näytteenottotaajuuden 16 000 Hz:iin

    dataset.append({
        "filename": file.name,
        "audio": audio,
        "sample_rate": sr
    })

print(f"Ladattu {len(dataset)} äänitettä")


from pathlib import Path
import librosa

audio_dir = Path("aanitteet")
suffixes = [".mp3", ".m4a"]

onnistuneet = []
epaonnistuneet = []

for file in sorted(audio_dir.iterdir()):
    if file.suffix.lower() not in suffixes:
        continue

    try:
        # Yritetään lukea äänite ja muuntaa 16 kHz:n näytteenottotaajuuteen
        audio, sr = librosa.load(file, sr=16000)

        onnistuneet.append(file.name)
        print(f"OK: {file.name}")

    except Exception as e:
        # Tulostetaan virheen aiheuttanut tiedosto ja virheilmoitus
        epaonnistuneet.append(file.name)
        print(f"VIRHE: {file.name}")
        print(f"  {type(e).__name__}: {e}")

print("\n=== YHTEENVETO ===")
print(f"Onnistuneet: {len(onnistuneet)}")
print(f"Epäonnistuneet: {len(epaonnistuneet)}")
print(f"Yhteensä: {len(onnistuneet) + len(epaonnistuneet)}")















